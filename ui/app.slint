import { Button, ScrollView, LineEdit } from "std-widgets.slint";

export struct ClipData {
    id: string,
    text: string,
    is_favorite: bool,
    clip_type: string,
    image_path: string,
    image_width: int,
    image_height: int,
    ocr_text: string,
    dimension_text: string,
}

export component MainWindow inherits Window {
    title: "Clipped";
    no-frame: true;
    background: transparent;
    preferred-width: 580px;
    preferred-height: 380px;
    default-font-family: "Segoe UI, -apple-system, system-ui, sans-serif";

    in-out property <[ClipData]> clips: [];
    in-out property <int> selected_index: 0;
    in-out property <bool> show_favorites: false;
    in-out property <bool> is_search_visible: false;
    in-out property <bool> search_enabled: false;
    in-out property <string> search_query: "";
    in-out property <bool> show_settings: false;
    in-out property <string> shortcut_input: "Ctrl+Alt+Shift+.";
    in-out property <string> shortcut_current: "Ctrl+Alt+Shift+.";
    in-out property <string> shortcut_error: "";
    in-out property <image> active_image;

    callback select_index(int);
    callback toggle_favorite(string);
    callback delete_clip(string);
    callback toggle_favorites_filter();
    callback search_changed(string);
    callback search_closed();
    callback paste_selected();
    callback hide_requested();
    callback save_shortcut();
    callback close_settings();
    callback set_shortcut_input(string);

    public function focus_main() {
        main-scope.focus();
    }

    forward-focus: main-scope;

    main-scope := FocusScope {
        init => {
            self.focus();
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.show_settings) {
                    root.close_settings();
                    return accept;
                }
                if (root.is_search_visible && root.search_query != "") {
                    root.search_closed();
                    return accept;
                }
                root.hide_requested();
                return accept;
            }
            if (event.text == Key.Return) {
                root.paste_selected();
                return accept;
            }
            if (event.text == Key.Delete) {
                if (root.clips.length > 0 && root.selected_index >= 0 && root.selected_index < root.clips.length) {
                    root.delete_clip(root.clips[root.selected_index].id);
                }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                if (root.clips.length > 0) {
                    if (root.selected_index > 0) {
                        root.selected_index -= 1;
                    } else {
                        root.selected_index = root.clips.length - 1;
                    }
                    root.select_index(root.selected_index);
                }
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == Key.RightArrow || event.text == Key.Tab) {
                if (root.clips.length > 0) {
                    if (root.selected_index < root.clips.length - 1) {
                        root.selected_index += 1;
                    } else {
                        root.selected_index = 0;
                    }
                    root.select_index(root.selected_index);
                }
                return accept;
            }
            // Number navigation 1-9
            if (event.text == "1" || event.text == "2" || event.text == "3" ||
                event.text == "4" || event.text == "5" || event.text == "6" ||
                event.text == "7" || event.text == "8" || event.text == "9") {
                if (!root.is_search_visible) {
                    // Convert char to index
                    if (event.text == "1") { root.select_index(0); return accept; }
                    if (event.text == "2") { root.select_index(1); return accept; }
                    if (event.text == "3") { root.select_index(2); return accept; }
                    if (event.text == "4") { root.select_index(3); return accept; }
                    if (event.text == "5") { root.select_index(4); return accept; }
                    if (event.text == "6") { root.select_index(5); return accept; }
                    if (event.text == "7") { root.select_index(6); return accept; }
                    if (event.text == "8") { root.select_index(7); return accept; }
                    if (event.text == "9") { root.select_index(8); return accept; }
                }
            }

            // Typing printable character triggers search
            if (!root.show_settings && !root.is_search_visible && root.search_enabled) {
                if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta &&
                    event.text != "" && event.text != Key.Escape && event.text != Key.Return && 
                    event.text != Key.Delete && event.text != Key.Backspace &&
                    event.text != Key.UpArrow && event.text != Key.DownArrow &&
                    event.text != Key.LeftArrow && event.text != Key.RightArrow &&
                    event.text != Key.Tab && event.text != Key.Shift &&
                    event.text != Key.Control && event.text != Key.Alt) {
                    root.is_search_visible = true;
                    root.search_query = event.text;
                    root.search_changed(event.text);
                    search_input.focus();
                    return accept;
                }
            }
            return reject;
        }

        // Outer rounded card
        card := Rectangle {
            width: 100%;
            height: 100%;
            background: #1e1e2ef0;
            border-radius: 20px;
            border-width: 1px;
            border-color: #ffffff14;
            clip: true;

            VerticalLayout {
                padding-top: 14px;
                padding-bottom: 16px;
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;

                // Header
                header := HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    height: 28px;

                    if root.show_settings : Text {
                        text: "Settings";
                        font-size: 15px;
                        font-weight: 600;
                        color: #e2e8f0;
                        vertical-alignment: center;
                    }

                    if !root.show_settings : Rectangle {
                        width: 44px;
                        height: 26px;
                        background: #0000004d;
                        border-radius: 13px;
                        border-width: 1px;
                        border-color: #ffffff14;

                        Text {
                            text: (root.clips.length > 0) ? (root.selected_index + 1) : 0;
                            color: #cbd5e1;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if !root.show_settings : fav_toggle := Rectangle {
                        width: 28px;
                        height: 26px;
                        border-radius: 6px;
                        background: fav_touch.has-hover ? #ffffff0f : #00000000;

                        Image {
                            source: root.show_favorites ? @image-url("../assets/star-active.svg") : @image-url("../assets/star.svg");
                            width: 18px;
                            height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        fav_touch := TouchArea {
                            clicked => {
                                root.toggle_favorites_filter();
                                main-scope.focus();
                            }
                        }
                    }

                    search_box := Rectangle {
                        width: (root.is_search_visible && !root.show_settings) ? 160px : 0px;
                        height: 28px;
                        background: #00000033;
                        border-width: (root.is_search_visible && !root.show_settings) ? 1px : 0px;
                        border-color: #ffffff26;
                        border-radius: 6px;
                        visible: root.is_search_visible && !root.show_settings;

                        search_input := TextInput {
                            text <=> root.search_query;
                            font-size: 13px;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            edited => {
                                if (self.text == "") {
                                    root.is_search_visible = false;
                                }
                                root.search_changed(self.text);
                            }
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    if (root.search_query != "") {
                                        root.search_closed();
                                        main-scope.focus();
                                    } else {
                                        root.hide_requested();
                                    }
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.paste_selected();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    if (root.clips.length > 0) {
                                        if (root.selected_index > 0) {
                                            root.selected_index -= 1;
                                        } else {
                                            root.selected_index = root.clips.length - 1;
                                        }
                                        root.select_index(root.selected_index);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.clips.length > 0) {
                                        if (root.selected_index < root.clips.length - 1) {
                                            root.selected_index += 1;
                                        } else {
                                            root.selected_index = 0;
                                        }
                                        root.select_index(root.selected_index);
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                // Content Viewport
                content_rect := Rectangle {
                    background: #00000033;
                    border-radius: 12px;
                    clip: true;

                    content_touch := TouchArea {
                        clicked => {
                            main-scope.focus();
                        }
                    }

                    // 1. Settings View
                    if root.show_settings : VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        alignment: start;

                        Text {
                            text: "Open clipboard shortcut";
                            font-size: 13px;
                            color: #aaaaaa;
                        }

                        Rectangle {
                            height: 36px;
                            background: #00000033;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #ffffff14;

                            Text {
                                text: root.shortcut_input;
                                font-size: 14px;
                                color: #ffffff;
                                x: 12px;
                                vertical-alignment: center;
                            }
                        }

                        if root.shortcut_error != "" : Text {
                            text: root.shortcut_error;
                            color: #f87171;
                            font-size: 12px;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            height: 32px;

                            Rectangle {
                                width: 70px;
                                background: #646cff;
                                border-radius: 8px;

                                Text {
                                    text: "Save";
                                    color: #ffffff;
                                    font-size: 13px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.save_shortcut(); }
                                }
                            }

                            Rectangle {
                                width: 70px;
                                background: #ffffff14;
                                border-radius: 8px;

                                Text {
                                    text: "Back";
                                    color: #ffffff;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.close_settings(); }
                                }
                            }
                        }

                        Text {
                            text: "Current: " + root.shortcut_current;
                            color: #777777;
                            font-size: 12px;
                        }
                    }

                    // 2. Empty State
                    if !root.show_settings && root.clips.length == 0 : VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Clipboard is empty";
                            color: #888888;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }
                    }

                    // 3. Single Card View (when not searching and not favorites)
                    if !root.show_settings && !root.is_search_visible && !root.show_favorites && root.clips.length > 0 : ScrollView {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            alignment: start;

                            // Image clip
                            if root.clips[root.selected_index].clip_type == "image" : VerticalLayout {
                                spacing: 10px;
                                alignment: center;

                                Rectangle {
                                    border-radius: 10px;
                                    background: #00000040;
                                    clip: true;
                                    height: 180px;

                                    Image {
                                        source: root.active_image;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Rectangle {
                                        background: #ffffff14;
                                        border-radius: 6px;
                                        height: 22px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: root.clips[root.selected_index].dimension_text;
                                                color: #aaaaaa;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                if root.clips[root.selected_index].ocr_text != "" : Rectangle {
                                    background: #0000004d;
                                    border-radius: 6px;

                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: root.clips[root.selected_index].ocr_text;
                                            color: #dddddd;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // Text clip
                            if root.clips[root.selected_index].clip_type != "image" : Text {
                                text: root.clips[root.selected_index].text;
                                color: #f8fafc;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // 4. Multi-Item List View (search or favorites filter)
                    if !root.show_settings && (root.is_search_visible || root.show_favorites) && root.clips.length > 0 : ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 4px;
                            alignment: start;

                            for clip[idx] in root.clips : item_row := Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: (idx == root.selected_index) 
                                    ? (clip.is_favorite ? #fbbf2433 : #ffffff26)
                                    : (item_touch.has-hover ? #ffffff0d : #00000000);

                                if (idx == root.selected_index) || clip.is_favorite : Rectangle {
                                    x: 0;
                                    y: 4px;
                                    width: 3px;
                                    height: parent.height - 8px;
                                    border-radius: 1.5px;
                                    background: clip.is_favorite ? #fbbf24 : #646cff;
                                }

                                item_touch := TouchArea {
                                    clicked => {
                                        root.select_index(idx);
                                        main-scope.focus();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: clip.text;
                                        color: (idx == root.selected_index) ? #ffffff : #cbd5e1;
                                        font-size: 13px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    if clip.is_favorite : Image {
                                        source: @image-url("../assets/star-active.svg");
                                        width: 14px;
                                        height: 14px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom-Center Action Dock
            if !root.show_settings && root.clips.length > 0 : action_dock := Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 18px;
                width: 78px;
                height: 30px;
                border-radius: 15px;
                background: #12121eeb;
                border-width: 1px;
                border-color: #ffffff26;
                opacity: (content_touch.has-hover || dock_touch.has-hover) ? 1.0 : 0.85;

                animate opacity { duration: 150ms; easing: ease-out; }

                dock_touch := TouchArea {}

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    trash_btn := Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: trash_touch.has-hover ? #f8717126 : #00000000;

                        Image {
                            source: trash_touch.has-hover ? @image-url("../assets/trash-hover.svg") : @image-url("../assets/trash.svg");
                            width: 15px;
                            height: 15px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        trash_touch := TouchArea {
                            clicked => {
                                if (root.clips.length > 0 && root.selected_index >= 0 && root.selected_index < root.clips.length) {
                                    root.delete_clip(root.clips[root.selected_index].id);
                                    main-scope.focus();
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        height: 14px;
                        background: #ffffff26;
                        y: 8px;
                    }

                    star_btn := Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: star_touch.has-hover ? #fbbf2426 : #00000000;

                        Image {
                            source: (root.clips.length > 0 && root.selected_index >= 0 && root.selected_index < root.clips.length && root.clips[root.selected_index].is_favorite)
                                ? @image-url("../assets/star-active.svg")
                                : @image-url("../assets/star.svg");
                            width: 15px;
                            height: 15px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        star_touch := TouchArea {
                            clicked => {
                                if (root.clips.length > 0 && root.selected_index >= 0 && root.selected_index < root.clips.length) {
                                    root.toggle_favorite(root.clips[root.selected_index].id);
                                    main-scope.focus();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
